{
    "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
    "format": 1,
    "name": "Pokémon Ruby (Recompiled)",
    "game": {
        "kind": "iso",
        "label": "Your Pokémon Ruby (USA rev 1) ROM (.gba).",
        "dumps": [
            {
                "name": "USA rev 1",
                "crc32": "61641576"
            }
        ]
    },
    "start": {
        "program": [
            "RubyRecomp.exe"
        ],
        "args": [
            "--rom",
            "{game}"
        ]
    },
    "requires": [
        "start"
    ]
}
